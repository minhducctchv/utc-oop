sequenceDiagram
    autonumber
    actor Lib as 👩‍💼 Thủ thư
    participant Ctrl as LoanController<br/>(/api/v1/loans)
    participant Svc as CirculationAppService
    participant MemRepo as IMemberRepository
    participant Pol as IBorrowingPolicy
    participant CopyRepo as IBookCopyRepository
    participant LoanAgg as Loan (AggregateRoot)
    participant UoW as IUnitOfWork & EventBus

    Lib->>Ctrl: POST /api/v1/loans {memberCode, barcodes[]}
    activate Ctrl
    Ctrl->>Svc: checkoutBooks(CheckoutCommand)
    activate Svc

    Svc->>MemRepo: findByMemberCode(memberCode)
    MemRepo-->>Svc: member: Member
    Svc->>Pol: getPolicyFor(member.memberType)
    Pol-->>Svc: policy (maxBooks, maxLoanDays)
    Svc->>Svc: member.canBorrow(barcodes.size, policy)

    alt Thẻ hết hạn, bị khóa hoặc vượt hạn mức
        Svc-->>Ctrl: throw BusinessRuleException (422)
        Ctrl-->>Lib: HTTP 422 ProblemDetails (Lý do từ chối)
    else Đủ điều kiện mượn sách
        Svc->>LoanAgg: Loan.create(member.id, librarianId, dueDate)
        activate LoanAgg

        loop Với từng mã vạch barcode trong barcodes[]
            Svc->>CopyRepo: findByBarcodeForUpdate(barcode)
            CopyRepo-->>Svc: copy: BookCopy
            Svc->>CopyRepo: markBorrowed() & giảm availableCopies
            Svc->>LoanAgg: addItem(copy)
        end

        LoanAgg-->>Svc: loan (status = ACTIVE)
        deactivate LoanAgg

        Svc->>MemRepo: member.incrementActiveLoans(count)
        Svc->>UoW: commitTransaction() & publish(BookCheckedOutEvent)
        UoW-->>Svc: Committed OK

        Svc-->>Ctrl: LoanReceiptDto (loanCode, items, dueDate)
        Ctrl-->>Lib: HTTP 201 Created + JSON LoanReceiptDto
    end
    deactivate Svc
    deactivate Ctrl
