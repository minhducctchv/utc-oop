flowchart TB
    Start(("● Bắt đầu")) --> HandOver["👤 Bạn đọc mang sách đến Quầy lưu thông"]
    HandOver --> ScanCopy["👩‍💼 Thủ thư quét Barcode trên BookCopy<br/>Hệ thống truy xuất Loan & LoanItem đang ACTIVE/OVERDUE"]
    ScanCopy --> Inspect["👩‍💼 Thủ thư kiểm định tình trạng vật lý cuốn sách<br/>(GOOD / MINOR_WEAR / DAMAGED / LOST)"]

    Inspect --> CheckLateOrDmg{"⚙️ Trả quá hạn dueDate<br/>HOẶC sách bị hư hỏng/mất?"}

    CheckLateOrDmg -- "Đúng hạn & Nguyên vẹn" --> UpdateItem["✅ Cập nhật LoanItem (RETURNED)<br/>Giảm activeLoansCount của Member"]

    CheckLateOrDmg -- "Quá hạn / Hư hỏng" --> CalcFine["💰 <b>IFineCalculationStrategy:</b><br/>Tính phí quá hạn (ngày trễ × đơn giá) + phí đền bù hư hỏng<br/>Tạo FineInvoice (UNPAID) & Cộng nợ Member"]
    CalcFine --> PayNow{"💳 Bạn đọc thanh toán<br/>ngay tại quầy / VietQR?"}
    PayNow -- "Thanh toán ngay" --> ProcessPay["✅ Tạo bản ghi Payment (COMPLETED)<br/>Cập nhật FineInvoice = PAID & Khấu trừ nợ phạt"]
    PayNow -- "Ghi nợ tạm thời" --> KeepDebt["⚠️ Giữ trạng thái FineInvoice = UNPAID<br/>(Khóa quyền mượn mới nếu vượt ngưỡng)"]
    ProcessPay --> UpdateItem
    KeepDebt --> UpdateItem

    UpdateItem --> CheckCond{"⚙️ Sách còn sử dụng<br/>lưu thông được không?"}
    CheckCond -- "Hư hỏng nặng / Mất" --> MarkMaint["🔧 Chuyển BookCopy sang MAINTENANCE / LOST"]
    CheckCond -- "Tình trạng tốt" --> CheckQueue{"📋 Có phiếu Reservation đang chờ<br/>cho đầu sách BookTitle này?"}

    CheckQueue -- "Có hàng đợi chờ" --> HoldForNext["📌 Gán BookCopy cho người xếp hàng số 1<br/>BookCopy -> RESERVED (giữ 48h) & Gửi Email/Push"]
    CheckQueue -- "Không có người chờ" --> MakeAvail["📗 BookCopy -> AVAILABLE<br/>Tăng availableCopies của BookTitle (+1)"]

    MarkMaint --> CloseCheck{"Tất cả LoanItem trong Loan<br/>đã trả hết?"}
    HoldForNext --> CloseCheck
    MakeAvail --> CloseCheck

    CloseCheck -- "Đã trả đủ" --> CloseLoan["🔒 Đóng phiếu mượn: Loan.status = CLOSED"]
    CloseCheck -- "Còn sách chưa trả" --> KeepOpen["📂 Giữ Loan.status = ACTIVE / PARTIALLY_RETURNED"]
    CloseLoan --> EndOK(("◉ Hoàn tất"))
    KeepOpen --> EndOK

    classDef startend fill:#1B365D,stroke:#0D1B2A,color:#FFFFFF
    classDef dec fill:#FFF8E1,stroke:#F57F17,stroke-width:2px,color:#E65100
    classDef warn fill:#FFEBEE,stroke:#C62828,color:#B71C1C
    classDef ok fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#1B5E20
    class Start,EndOK startend
    class CheckLateOrDmg,PayNow,CheckCond,CheckQueue,CloseCheck dec
    class CalcFine,KeepDebt,MarkMaint warn
    class ProcessPay,UpdateItem,HoldForNext,MakeAvail,CloseLoan ok
