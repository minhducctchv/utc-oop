classDiagram
    direction TB

    class UserAccount {
        <<Entity>>
        -UUID id
        -String username
        -String email
        -String passwordHash
        -AccountStatus status
        +verifyPassword(raw: String) Boolean
        +lockAccount() void
    }

    class Role {
        <<Entity>>
        -UUID id
        -String code
        -String name
        -Set~String~ permissions
        +hasPermission(perm: String) Boolean
    }

    class Member {
        <<AggregateRoot>>
        -UUID id
        -UUID userId
        -String memberCode
        -String fullName
        -MemberType memberType
        -LocalDate cardExpiryDate
        -int activeLoansCount
        -Money unpaidFineBalance
        -MemberStatus status
        +canBorrow(count: int, policy: IBorrowingPolicy) Boolean
        +incrementActiveLoans(count: int) void
        +decrementActiveLoans(count: int) void
        +addFineBalance(amount: Money) void
        +settleFineBalance(amount: Money) void
    }

    class BookTitle {
        <<AggregateRoot>>
        -UUID id
        -ISBN isbn
        -String title
        -String edition
        -int publishYear
        -String language
        -int totalCopies
        -int availableCopies
        +updateAvailability(delta: int) void
        +hasAvailableCopy() Boolean
    }

    class BookCopy {
        <<Entity>>
        -UUID id
        -UUID bookTitleId
        -Barcode barcode
        -String rfidTag
        -String shelfLocation
        -CopyCondition condition
        -Money price
        -CopyStatus status
        +markBorrowed() void
        +markReturned(cond: CopyCondition) void
        +markReserved() void
        +markMaintenance() void
        +isAvailableForLoan() Boolean
    }

    class Category {
        <<Entity>>
        -UUID id
        -String ddcCode
        -String name
        -UUID parentId
    }

    class Author {
        <<Entity>>
        -UUID id
        -String fullName
        -String orcid
    }

    class Publisher {
        <<Entity>>
        -UUID id
        -String name
        -String email
    }

    class ISBN {
        <<ValueObject>>
        -String value
        +isValidChecksum() Boolean
    }

    Role "1..*" -- "0..*" UserAccount
    UserAccount "1" -- "0..1" Member
    Category "1" o-- "0..*" BookTitle
    Publisher "1" o-- "0..*" BookTitle
    Author "1..*" -- "0..*" BookTitle
    BookTitle "1" *-- "1..*" BookCopy
    BookTitle *-- ISBN
