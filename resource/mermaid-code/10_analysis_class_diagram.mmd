classDiagram
    direction TB

    class UserAccount {
        +username
        +email
        +passwordHash
        +status
    }

    class Role {
        +code
        +name
        +permissions
    }

    class Member {
        +memberCode
        +fullName
        +memberType
        +cardExpiryDate
        +activeLoansCount
        +unpaidFineBalance
        +status
    }

    class Category {
        +ddcCode
        +name
        +description
    }

    class Publisher {
        +name
        +address
        +email
    }

    class Author {
        +fullName
        +biography
        +orcid
    }

    class BookTitle {
        +isbn
        +title
        +edition
        +publishYear
        +language
        +totalCopies
        +availableCopies
    }

    class BookCopy {
        +barcode
        +rfidTag
        +shelfLocation
        +condition
        +price
        +status
    }

    class Loan {
        +loanCode
        +borrowedAt
        +dueDate
        +closedAt
        +renewalCount
        +status
    }

    class LoanItem {
        +returnedAt
        +conditionOut
        +conditionIn
        +overdueDays
        +itemStatus
    }

    class Reservation {
        +reservationCode
        +queuePosition
        +createdAt
        +holdExpiresAt
        +status
    }

    class FineInvoice {
        +invoiceCode
        +reason
        +amount
        +paidAmount
        +status
    }

    class Payment {
        +transactionRef
        +method
        +amount
        +paidAt
        +status
    }

    Role "1..*" -- "0..*" UserAccount : phân quyền >
    UserAccount "1" -- "0..1" Member : liên kết hồ sơ >
    Category "1" o-- "0..*" BookTitle : phân loại >
    Publisher "1" o-- "0..*" BookTitle : xuất bản >
    Author "1..*" -- "0..*" BookTitle : sáng tác >
    BookTitle "1" *-- "1..*" BookCopy : gồm các bản sao >
    Member "1" -- "0..*" Loan : thực hiện mượn >
    Loan "1" *-- "1..*" LoanItem : chứa chi tiết >
    LoanItem "0..*" --> "1" BookCopy : tham chiếu cuốn sách >
    Member "1" -- "0..*" Reservation : đặt chỗ trước >
    Reservation "0..*" --> "1" BookTitle : đăng ký đầu sách >
    Reservation "0..1" --> "0..1" BookCopy : được gán bản sao >
    Loan "1" -- "0..*" FineInvoice : phát sinh phạt >
    FineInvoice "1" *-- "0..*" Payment : thanh toán qua >
