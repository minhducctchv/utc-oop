flowchart LR
    Req["📨 <b>HTTP Request</b><br/>GET / POST / PATCH / DELETE<br/>/api/v1/resources"]
    Cors["🛡️ <b>1. CORS & Rate Limit</b><br/>Token Bucket Redis<br/>(Chống DDoS / Brute-force)"]
    Auth["🔐 <b>2. JWT & RBAC Guard</b><br/>Xác thực RS256 Bearer<br/>Kiểm tra Role & Scope"]
    Val["✅ <b>3. Schema Validation</b><br/>Kiểm tra DTO, kiểu dữ liệu,<br/>Idempotency-Key"]
    Ctrl["🔌 <b>4. REST Controller</b><br/>Ánh xạ DTO -> Command/Query<br/>Gọi Application Service"]
    Dom["🏛️ <b>5. DDD Domain Execution</b><br/>Thực thi bất biến Aggregate<br/>& Giao dịch ACID"]
    Resp["📤 <b>6. Chuẩn hóa Response</b><br/>200/201 Envelope JSON<br/>hoặc lỗi chuẩn RFC 7807"]

    Req --> Cors --> Auth --> Val --> Ctrl --> Dom --> Resp

    Cors -. "429 Too Many Requests" .-> Resp
    Auth -. "401 / 403 Unauthorized" .-> Resp
    Val -. "400 Bad Request" .-> Resp
    Dom -. "409 / 422 Domain Rule Error" .-> Resp

    classDef step fill:#EBF3FA,stroke:#1B365D,stroke-width:2px,color:#1B365D
    classDef core fill:#1B365D,stroke:#0D1B2A,stroke-width:2px,color:#FFFFFF
    classDef io fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#1B5E20
    class Req,Resp io
    class Cors,Auth,Val,Ctrl step
    class Dom core
