flowchart TB
    Start(("● Bắt đầu")) --> Search["👤 Bạn đọc tra cứu OPAC và chọn Đầu sách (BookTitle)"]
    Search --> CheckAvail{"⚙️ Đầu sách còn bản sao<br/>AVAILABLE trên kệ không?"}

    CheckAvail -- "Còn bản sao sẵn sàng (availableCopies > 0)" --> SuggestDirect["ℹ️ Thông báo vị trí kệ để bạn đọc lấy trực tiếp<br/>(Chỉ cho phép Đặt trước khi hết bản sao rảnh)"]
    SuggestDirect --> EndEarly(("◉ Kết thúc"))

    CheckAvail -- "Tất cả bản sao đang BORROWED / RESERVED" --> CheckElig{"⚙️ Thẻ bạn đọc hợp lệ, chưa đặt trùng<br/>& chưa vượt tối đa 3 phiếu chờ?"}
    CheckElig -- "Không đủ điều kiện" --> Reject["❌ Từ chối yêu cầu đặt trước & hiển thị nguyên nhân"]
    Reject --> EndEarly

    CheckElig -- "Đủ điều kiện" --> CreateQueue["📝 Tạo Reservation (status = PENDING)<br/>Xếp thứ tự FIFO: queuePosition = max + 1"]
    CreateQueue --> WaitEvent["⏳ Chờ sự kiện Domain Event: BookReturnedEvent"]
    WaitEvent --> Allocate["📌 Hệ thống tự động gán BookCopy vừa trả cho đầu hàng đợi<br/>Reservation -> READY_FOR_PICKUP (holdExpiresAt = +48h)<br/>BookCopy -> RESERVED"]
    Allocate --> SendAlert["📧 Gửi Email & Push Notification mời bạn đọc đến nhận sách"]

    SendAlert --> PickupDecision{"⏰ Bạn đọc đến quầy nhận sách<br/>trong vòng 48 giờ?"}
    PickupDecision -- "Đến nhận đúng hạn" --> Fulfill["✅ Chuyển sang quy trình Lập phiếu mượn (UC04)<br/>Reservation -> FULFILLED"]
    PickupDecision -- "Quá 48h không đến (Cronjob)" --> Expire["⌛ Reservation -> EXPIRED<br/>Giải phóng BookCopy để chuyển cho người kế tiếp hoặc lên kệ"]

    Fulfill --> EndOK(("◉ Hoàn tất"))
    Expire --> EndOK

    classDef startend fill:#1B365D,stroke:#0D1B2A,color:#FFFFFF
    classDef dec fill:#FFF8E1,stroke:#F57F17,stroke-width:2px,color:#E65100
    classDef ok fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#1B5E20
    classDef err fill:#FFEBEE,stroke:#C62828,color:#B71C1C
    class Start,EndEarly,EndOK startend
    class CheckAvail,CheckElig,PickupDecision dec
    class CreateQueue,Allocate,Fulfill ok
    class Reject,Expire err
