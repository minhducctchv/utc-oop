flowchart TB
    subgraph LoanAgg["📦 LOAN AGGREGATE BOUNDARY (Tính nhất quán Giao dịch Tức thời - ACID)"]
        LoanRoot["👑 <b>Loan</b> «AggregateRoot»<br/>id: UUID | loanCode: String<br/>memberId: UUID | dueDate: LocalDate<br/>status: LoanStatus | version: long"]
        LoanItemEnt["📄 <b>LoanItem</b> «Entity»<br/>id: UUID | bookCopyId: UUID<br/>conditionOut / conditionIn<br/>overdueDays: int"]
        DateVO["💎 <b>DateRange</b> «ValueObject»<br/>borrowedAt .. dueDate"]
        LoanRoot ==>|"◆ 1..* Hợp thành"| LoanItemEnt
        LoanRoot ==>|"◆ Sở hữu VO"| DateVO
    end

    subgraph BookAgg["📦 BOOK CATALOG AGGREGATE BOUNDARY"]
        BookRoot["👑 <b>BookTitle</b> «AggregateRoot»<br/>id: UUID | title: String<br/>totalCopies / availableCopies"]
        IsbnVO["💎 <b>ISBN</b> «ValueObject»<br/>checksum ISBN-13"]
        CopyEnt["🏷️ <b>BookCopy</b> «Entity»<br/>id: UUID | shelfLocation<br/>status: CopyStatus"]
        BarcodeVO["💎 <b>Barcode</b> «ValueObject»<br/>UTC-BC-XXXXXX"]
        BookRoot ==>|"◆ Sở hữu VO"| IsbnVO
        BookRoot ==>|"◆ 1..* Hợp thành"| CopyEnt
        CopyEnt ==>|"◆ Sở hữu VO"| BarcodeVO
    end

    subgraph MemberAgg["📦 MEMBER AGGREGATE BOUNDARY"]
        MemberRoot["👑 <b>Member</b> «AggregateRoot»<br/>id: UUID | memberCode: String<br/>memberType: MemberType<br/>activeLoansCount: int"]
        MoneyVO["💎 <b>Money</b> «ValueObject»<br/>unpaidFineBalance (VND)"]
        MemberRoot ==>|"◆ Sở hữu VO"| MoneyVO
    end

    LoanRoot -.->|"Tham chiếu qua ID (memberId)"| MemberRoot
    LoanItemEnt -.->|"Tham chiếu qua ID (bookCopyId)"| CopyEnt

    classDef aggRoot fill:#1B365D,stroke:#0D1B2A,stroke-width:2px,color:#FFFFFF
    classDef ent fill:#E3F2FD,stroke:#1565C0,stroke-width:1.8px,color:#0D47A1
    classDef vo fill:#FFF8E1,stroke:#F57F17,stroke-width:1.8px,color:#E65100
    class LoanRoot,BookRoot,MemberRoot aggRoot
    class LoanItemEnt,CopyEnt ent
    class DateVO,IsbnVO,BarcodeVO,MoneyVO vo
