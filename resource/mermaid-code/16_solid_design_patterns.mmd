classDiagram
    direction TB

    class CirculationApplicationService {
        <<Service - SRP & DIP>>
        -ILoanRepository loanRepo
        -IBookCopyRepository copyRepo
        -IMemberRepository memberRepo
        -BorrowingPolicyFactory policyFactory
        -IDomainEventPublisher eventPub
        +checkoutBooks(cmd: CheckoutCommand) LoanDto
        +returnBooks(cmd: ReturnCommand) ReturnReceiptDto
    }

    class IBorrowingPolicy {
        <<interface - OCP & LSP>>
        +getMaxBooks() int
        +getMaxLoanDays() int
        +getMaxRenewals() int
    }

    class StudentBorrowingPolicy {
        +getMaxBooks() int
        +getMaxLoanDays() int
        +getMaxRenewals() int
    }

    class LecturerBorrowingPolicy {
        +getMaxBooks() int
        +getMaxLoanDays() int
        +getMaxRenewals() int
    }

    class PostgradBorrowingPolicy {
        +getMaxBooks() int
        +getMaxLoanDays() int
        +getMaxRenewals() int
    }

    class IFineCalculationStrategy {
        <<interface - OCP & Strategy>>
        +calculateFine(item: LoanItem, copy: BookCopy, daysLate: int) Money
    }

    class StandardOverdueFineStrategy {
        -Money dailyRate
        +calculateFine(item: LoanItem, copy: BookCopy, daysLate: int) Money
    }

    class RareReferenceFineStrategy {
        -Money highDailyRate
        +calculateFine(item: LoanItem, copy: BookCopy, daysLate: int) Money
    }

    class DamagedOrLostBookFineStrategy {
        -BigDecimal compensationFactor
        +calculateFine(item: LoanItem, copy: BookCopy, daysLate: int) Money
    }

    class ICatalogReader {
        <<interface - ISP>>
        +searchOpac(filter: SearchFilter) Page~BookSummaryDto~
        +getBookDetail(id: UUID) BookDetailDto
    }

    class ICatalogWriter {
        <<interface - ISP>>
        +createBookTitle(cmd: CreateBookCmd) UUID
        +addBookCopies(titleId: UUID, count: int) List~Barcode~
    }

    class ILoanRepository {
        <<interface - DIP>>
        +findById(id: UUID) Optional~Loan~
        +save(loan: Loan) void
    }

    class PostgresLoanRepository {
        <<Infrastructure Adapter>>
        +findById(id: UUID) Optional~Loan~
        +save(loan: Loan) void
    }

    CirculationApplicationService --> IBorrowingPolicy : ủy quyền chính sách
    CirculationApplicationService --> IFineCalculationStrategy : ủy quyền tính phạt
    CirculationApplicationService --> ILoanRepository : phụ thuộc Abstraction
    IBorrowingPolicy <|.. StudentBorrowingPolicy
    IBorrowingPolicy <|.. LecturerBorrowingPolicy
    IBorrowingPolicy <|.. PostgradBorrowingPolicy
    IFineCalculationStrategy <|.. StandardOverdueFineStrategy
    IFineCalculationStrategy <|.. RareReferenceFineStrategy
    IFineCalculationStrategy <|.. DamagedOrLostBookFineStrategy
    ILoanRepository <|.. PostgresLoanRepository
