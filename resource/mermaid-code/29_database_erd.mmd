erDiagram
    ROLES ||--o{ USERS : "phan_quyen"
    USERS ||--o| MEMBERS : "lien_ket_ho_so"
    CATEGORIES ||--o{ BOOK_TITLES : "phan_loai_ddc"
    PUBLISHERS ||--o{ BOOK_TITLES : "xuat_ban"
    BOOK_TITLES ||--o{ BOOK_AUTHORS : "co_tac_gia"
    AUTHORS ||--o{ BOOK_AUTHORS : "sang_tac"
    BOOK_TITLES ||--|{ BOOK_COPIES : "co_ban_sao"
    MEMBERS ||--o{ LOANS : "muon_sach"
    USERS ||--o{ LOANS : "thu_thu_lap_phieu"
    LOANS ||--|{ LOAN_ITEMS : "gom_chi_tiet"
    BOOK_COPIES ||--o{ LOAN_ITEMS : "duoc_muon_trong"
    MEMBERS ||--o{ RESERVATIONS : "dat_truoc"
    BOOK_TITLES ||--o{ RESERVATIONS : "duoc_dat_truoc"
    BOOK_COPIES |o--o{ RESERVATIONS : "gan_giu_cho"
    LOANS ||--o{ FINE_INVOICES : "phat_sinh_phat"
    MEMBERS ||--o{ FINE_INVOICES : "chiu_phat"
    FINE_INVOICES ||--o{ PAYMENTS : "thanh_toan"

    ROLES {
        uuid id PK
        varchar code UK
        varchar name
    }
    USERS {
        uuid id PK
        uuid role_id FK
        varchar username UK
        varchar email UK
        varchar password_hash
        varchar status
    }
    MEMBERS {
        uuid id PK
        uuid user_id FK
        varchar member_code UK
        varchar full_name
        varchar member_type
        date card_expiry_date
        int active_loans_count
        numeric unpaid_fine_balance
        varchar status
    }
    CATEGORIES {
        uuid id PK
        varchar ddc_code UK
        varchar name
        uuid parent_id FK
    }
    PUBLISHERS {
        uuid id PK
        varchar name
        varchar email
    }
    AUTHORS {
        uuid id PK
        varchar full_name
        varchar orcid
    }
    BOOK_TITLES {
        uuid id PK
        varchar isbn UK
        varchar title
        int publish_year
        uuid category_id FK
        uuid publisher_id FK
        int total_copies
        int available_copies
    }
    BOOK_AUTHORS {
        uuid book_title_id PK,FK
        uuid author_id PK,FK
        boolean is_primary
    }
    BOOK_COPIES {
        uuid id PK
        uuid book_title_id FK
        varchar barcode UK
        varchar rfid_tag UK
        varchar shelf_location
        varchar condition
        numeric price
        varchar status
    }
    LOANS {
        uuid id PK
        varchar loan_code UK
        uuid member_id FK
        uuid librarian_id FK
        timestamp borrowed_at
        date due_date
        int renewal_count
        varchar status
        bigint version
    }
    LOAN_ITEMS {
        uuid id PK
        uuid loan_id FK
        uuid book_copy_id FK
        timestamp returned_at
        varchar condition_out
        varchar condition_in
        int overdue_days
        varchar item_status
    }
    RESERVATIONS {
        uuid id PK
        varchar reservation_code UK
        uuid member_id FK
        uuid book_title_id FK
        uuid assigned_copy_id FK
        int queue_position
        timestamp hold_expires_at
        varchar status
    }
    FINE_INVOICES {
        uuid id PK
        varchar invoice_code UK
        uuid loan_id FK
        uuid member_id FK
        varchar reason
        numeric amount
        numeric paid_amount
        varchar status
    }
    PAYMENTS {
        uuid id PK
        uuid fine_invoice_id FK
        varchar transaction_ref UK
        varchar method
        numeric amount
        timestamp paid_at
        varchar status
    }
