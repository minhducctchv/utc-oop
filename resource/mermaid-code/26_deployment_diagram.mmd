flowchart TB
    subgraph EdgeZone["TẦNG THIẾT BỊ ĐẦU CUỐI (CLIENT & LIBRARY EDGE NODES)"]
        direction LR
        NodeBrowser["💻 «device»<br/><b>PC / Mobile Bạn đọc</b><br/>Browser HTTPS (TLS 1.3)"]
        NodeDesk["🖨️ «device»<br/><b>Máy trạm Quầy Thủ thư</b><br/>USB Barcode / Đầu đọc RFID + Máy in nhiệt"]
    end

    subgraph DMZ["DMZ & INGRESS TIER (DOCKER / KUBERNETES CLUSTER)"]
        Nginx["🌐 «node» <b>Nginx Reverse Proxy & WAF</b><br/>SSL Termination • Gzip • Rate Limiting (100 req/s)"]
    end

    subgraph AppCluster["APPLICATION TIER (PRIVATE SUBNET - AUTO SCALING)"]
        direction LR
        Pod1["📦 «executionEnv»<br/><b>utc-lib-api-pod-01</b><br/>REST API Container (Stateless)"]
        Pod2["📦 «executionEnv»<br/><b>utc-lib-api-pod-02</b><br/>REST API Container (Stateless)"]
        Worker["⏰ «executionEnv»<br/><b>utc-lib-worker</b><br/>Cron Overdue & Email Queue Worker"]
    end

    subgraph DataTier["DATA & STORAGE TIER (ISOLATED PRIVATE SUBNET)"]
        direction LR
        PGPrimary[("🗄️ «database»<br/><b>PostgreSQL 16 Primary</b><br/>Read/Write ACID + Streaming WAL")]
        PGReplica[("🗄️ «database»<br/><b>PostgreSQL Read Replica</b><br/>OPAC Search & Analytics")]
        RedisNode[("⚡ «node»<br/><b>Redis 7 Sentinel</b><br/>Cache, Session & Distributed Lock")]
        MinIONode[("☁️ «storage»<br/><b>MinIO S3 Storage</b><br/>Ảnh bìa & Tài liệu số PDF")]
    end

    NodeBrowser -->|"HTTPS :443"| Nginx
    NodeDesk -->|"HTTPS :443"| Nginx
    Nginx -->|"HTTP/2 :8080"| Pod1 & Pod2

    Pod1 & Pod2 -->|"TCP :5432 (Write)"| PGPrimary
    Pod1 & Pod2 -->|"TCP :5432 (Read)"| PGReplica
    PGPrimary -.->|"Async Replication"| PGReplica
    Pod1 & Pod2 & Worker -->|"TCP :6379"| RedisNode
    Pod1 & Pod2 -->|"S3 API :9000"| MinIONode
    Worker -->|"TCP :5432"| PGPrimary

    classDef dev fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1
    classDef app fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#1B5E20
    classDef db fill:#F3E5F5,stroke:#6A1B9A,stroke-width:2px,color:#4A148C
    class NodeBrowser,NodeDesk,Nginx dev
    class Pod1,Pod2,Worker app
    class PGPrimary,PGReplica,RedisNode,MinIONode db
